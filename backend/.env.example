# Copia este archivo a .env (NO lo subas a Git) y ajusta los valores.
DB_URL=jdbc:postgresql://localhost:5432/subastaweb
DB_USER=postgres
DB_PASSWORD=cambia-esto
# Opcional: crea un ADMIN inicial al arrancar (procedimiento controlado, RN-01)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrador
CORS_ALLOWED_ORIGINS=http://localhost:5173
STORAGE_DIR=./uploads
SESSION_COOKIE_SECURE=false
