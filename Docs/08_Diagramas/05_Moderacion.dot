// Aprobación o rechazo con transacción y auditoría
digraph {
	bgcolor=white dpi=145 fontname="DejaVu Sans" nodesep=0.35 pad=0.20 rankdir=TB ranksep=0.65 splines=polyline
	node [color="#17618c" fillcolor="#eef5f8" fontcolor="#19364e" fontname="DejaVu Sans" fontsize=10 margin="0.18,0.11" penwidth=1.1 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#4e6475" fontcolor="#4e6475" fontname="DejaVu Sans" fontsize=9]
	a [label="ADMIN abre
pendientes"]
	b [label="Bloquea auction
+ verifica ronda"]
	c [label="¿Decisión?" color="#bb842c" fillcolor="#fff0d9" shape=diamond]
	d [label="APROBAR:
ACTIVA + starts/ends" color="#2b7c5e" fillcolor="#e2f2e5"]
	e [label="RECHAZAR:
RECHAZADA + motivo" color="#ae4a4a" fillcolor="#fbe7e6"]
	f [label="Guarda revisión
y evento"]
	g [label="409 si obsoleta" color="#ae4a4a" fillcolor="#fbe7e6"]
	a -> b [label=""]
	b -> c [label="válida"]
	b -> g [label=conflicto]
	c -> d [label=Aprobar]
	c -> e [label=Rechazar]
	d -> f [label=""]
	e -> f [label=""]
}
