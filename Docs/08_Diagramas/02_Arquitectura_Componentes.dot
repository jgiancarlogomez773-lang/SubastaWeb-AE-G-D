// Arquitectura MVC+REST
digraph {
	bgcolor=white dpi=145 fontname="DejaVu Sans" nodesep=0.35 pad=0.20 rankdir=LR ranksep=0.65 splines=polyline
	node [color="#17618c" fillcolor="#eef5f8" fontcolor="#19364e" fontname="DejaVu Sans" fontsize=10 margin="0.18,0.11" penwidth=1.1 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#4e6475" fontcolor="#4e6475" fontname="DejaVu Sans" fontsize=9]
	browser [label="Navegador
Visitante / USER / ADMIN"]
	vue [label="SPA Vue 3 + Vite
Vistas / Router / formularios"]
	api [label="API Spring Boot
REST + Security + Services"]
	pg [label="PostgreSQL
7 tablas + Flyway"]
	img [label="Almacenamiento
de imágenes"]
	job [label="Job @Scheduled
Cierre y ganador"]
	browser -> vue [label="HTTP/HTTPS"]
	vue -> api [label="/api/v1 JSON"]
	api -> pg [label="SQL transaccional"]
	api -> img [label="clave opaca"]
	job -> api [label="servicio interno"]
}
